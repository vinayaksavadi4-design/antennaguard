# Local defaults work without this file.
# For deployment, set a strong unique secret and a PostgreSQL URL.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./antennaguard.db
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=120
MODEL_PATH=./models/antenna_rf.pkl
ENVIRONMENT=development
